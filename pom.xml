<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        独立根工程：不继承任何外部父 pom。
        依赖版本与插件版本全部写在本文档内，克隆下来即可构建，无需预先安装其它父工程。
    -->
    <groupId>com.orivone</groupId>
    <artifactId>orivone-dbupgrade</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>
    <modules>
        <module>orivone-dbupgrade-core</module>
        <module>orivone-dbupgrade-lock-redisson</module>
        <module>orivone-dbupgrade-spring-boot-starter</module>
        <!--
            demo 留在默认 reactor 里：clone 下来打开 IDE 就能看、能跑。
            它要求 JDK 17（Boot 4.1 的字节码下限），因此本地开发用 JDK 17 构建。

            发布到 Central 时切 JDK 8，并用 -pl 把 demo 排除出 reactor，命令见 CONTRIBUTING.md。
        -->
        <module>dbupgrade-demo</module>
    </modules>

    <!--
        ============================================================================
        Maven Central 发布元数据
        ============================================================================

        Central 对下面六项是硬校验，缺任何一项都会被直接拒收：
            name / description / url / licenses / developers / scm

        其中 scm 还要求 connection、developerConnection、url、tag 四个子元素齐全
        （tag 不能是 HEAD，必须是真实存在的发布标签）。

        这些字段只影响中央仓库的展示与校验，不参与编译。
    -->
    <name>orivone-dbupgrade</name>
    <description>声明式数据库升级框架：版本注册表 + 幂等 changeset 执行 + 六种方言 + Spring Boot 自动装配 + 分布式锁</description>
    <url>https://github.com/orivone/orivone-dbupgrade</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>OSI 认证的宽松许可证，允许商用与闭源分发</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>orivone</id>
            <name>orivone</name>
            <email>dev@orivone.com</email>
            <url>https://orivone.com</url>
            <organization>orivone</organization>
            <organizationUrl>https://orivone.com</organizationUrl>
            <roles>
                <role>architect</role>
                <role>developer</role>
            </roles>
            <timezone>Asia/Shanghai</timezone>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/orivone/orivone-dbupgrade.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/orivone/orivone-dbupgrade.git</developerConnection>
        <url>https://github.com/orivone/orivone-dbupgrade</url>
        <tag>v1.0.1</tag>
    </scm>

    <!--
        ============================================================================
        兼容性基线（改动前确认 README 的兼容矩阵是否需要同步）
        ============================================================================

        1) 字节码 = Java 8
           全工程用 javac 的 release 参数编译，它在语法之外还用 ct.sym 校验 API，
           比 source/target 严格（误用 JDK 9+ 方法会直接编译失败），因此不需要 animal-sniffer。
           例外：spring-boot-demo 跑 Boot 4，最低 JDK 17，单独覆盖为 17。

        2) Spring Boot 编译基线 = 2.7.18，运行期兼容 2.7 / 3.x / 4.x
           按最低版本编译：能在 2.7 编过，就必然能被 3.x / 4.x 加载；反之不成立。

        3) MySQL 最低 5.7，驱动固定 8.0.33
           Connector/J 9.x 只支持 server 8.0+，8.0.33 是能横跨 5.7 / 8.0 / 8.4 的版本。
    -->
    <properties>

        <!-- ============ 字节码基线 ============ -->
        <jdk.version>8</jdk.version>
        <maven.compiler.release>8</maven.compiler.release>
        <!-- release 生效时 source/target 会被忽略，这里保留是为了 IDE 与旧插件的兼容 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <encoding>UTF-8</encoding>

        <!-- ============ Spring Boot 兼容矩阵 ============ -->
        <!-- 编译基线：最低支持的 Boot 版本，starter 只依赖它提供的 API -->
        <spring-boot.baseline.version>2.7.18</spring-boot.baseline.version>
        <!-- 全工程默认落在 2.7 基线；demo 的 boot3 / boot4 profile 再单独覆盖 -->
        <spring-boot.version>${spring-boot.baseline.version}</spring-boot.version>

        <!-- demo 族各自回归的 Boot 版本（spring-boot-demo 的 profile 会用这三个） -->
        <spring-boot2.version>2.7.18</spring-boot2.version>
        <spring-boot3.version>3.4.9</spring-boot3.version>
        <spring-boot4.version>4.1.0</spring-boot4.version>

        <!-- ============ 数据层 ============ -->
        <!-- MySQL 驱动：9.x 起只支持 server 8.0+，固定在这个能横跨 5.7 / 8.0 / 8.4 的版本 -->
        <mysql.version>8.0.33</mysql.version>

        <!-- Redis 锁（orivone-dbupgrade-lock-redisson）用的 Redisson 版本 -->
        <redisson.version>4.6.1</redisson.version>

        <!-- ============ 日志 ============ -->
        <!-- 以 1.7.36 为编译基线：slf4j 1.7 与 2.0 的 Logger/LoggerFactory 二进制兼容，
             用 1.7 编译的代码在 2.0 运行期同样可用，反之亦然。 -->
        <slf4j.version>1.7.36</slf4j.version>

        <!-- ============ 构建插件 ============ -->
        <mvn.resources.version>2.6</mvn.resources.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>

        <!-- ============ 发布链路 ============ -->
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <!--
            0.7.0 无法解析 Central 新增的 warnings 字段，会在轮询结果时抛
            UnrecognizedPropertyException（产物其实已上传成功，但构建显示失败）。
            0.8 起补齐了这个模型，这里固定到 0.12.0。
        -->
        <central-publishing-plugin.version>0.12.0</central-publishing-plugin.version>
        <!-- spring-boot-maven-plugin 只在 demo 里用到，取 demo 默认那条 Boot 线的版本 -->
        <spring-boot.mvn.version>${spring-boot4.version}</spring-boot.mvn.version>

    </properties>


    <dependencyManagement>
        <dependencies>

            <!--
                Spring Boot BOM：版本由上面的 spring-boot.version 决定（= 2.7.18）。
                demo 里需要更高 Boot 的模块，自己再 import 一份 BOM 覆盖回去
                （子 pom 的 dependencyManagement 优先级更高）。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Redisson 只被 orivone-dbupgrade-lock-redisson 使用，版本在这里统一管理 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <!--
            不设 finalName：一旦写死，本地产物名就与中央仓库的 ${artifactId}-${version} 不一致，
            排查依赖版本时容易对不上号。默认值已经是 ${artifactId}-${version}。
        -->
        <plugins>
            <!-- 资源文件拷贝插件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${mvn.resources.version}</version>
                <configuration>
                    <encoding>${encoding}</encoding>
                </configuration>
            </plugin>
            <!-- java编译插件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <!--
                        release 8 在 JDK 21+ 会被标记为 obsolete（仅告警，仍然可用），
                        这里关掉该告警，避免每个模块刷 3 行噪音。
                        真正的「release 8 会不会被移除」风险见 README 的构建链说明。
                    -->
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!--
                显式锁定 surefire 3.x：Maven 3.6 自带的 2.x 只识别 JUnit 4，
                遇到 junit-jupiter 会打印 "Tests run: 0" 并判定构建成功。
                surefire 的默认版本跟随 Maven 版本，不能依赖它。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${mvn.resources.version}</version>
                    <configuration>
                        <encoding>${encoding}</encoding>

                    </configuration>
                </plugin>


                <!--
                    ========================================================================
                    源码包与文档包（只在 -Pcentral 时真正执行，见文件末尾的 profile）
                    ========================================================================
                    Central 对这两种附属构件是硬要求：只上传二进制 jar 会被直接拒收。
                    这里只做「版本 + 配置」的登记，不绑执行；
                    执行绑在 central profile 里，好处是日常 mvn clean package
                    不需要本地仓库里预先存在这两个插件。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <!--
                            encoding 必须显式写 UTF-8：否则 javadoc 在 Windows 上按 GBK 读源码，
                            中文注释会报「编码不可映射字符」并中断构建（该问题只在 Windows 出现）。

                            doclint 必须关闭：用 JDK 17/21 跑 javadoc 时，它会把缺失的
                            @param / @return 与注释中的裸 &lt; &gt; 判为错误，一次可达上百条。
                        -->
                        <encoding>UTF-8</encoding>
                        <charset>UTF-8</charset>
                        <docencoding>UTF-8</docencoding>
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                        <!-- 不因为漏写一个 @param 就让整条发布链路中断 -->
                        <failOnError>false</failOnError>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.mvn.version}</version>
                    <configuration>
                        <!-- <fork>true</fork>-->
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

    <!--
        ============================================================================
        发布到 Maven Central
        ============================================================================

        默认构建（mvn clean install）不经过这一段，本地开发不受 GPG 影响；
        只有显式加 -Pcentral 才启用签名与上传：

            mvn -Pcentral clean deploy

        profile 化的原因：maven-gpg-plugin 找不到本地私钥会直接让构建失败，
        若挂在默认生命周期上，未配置 GPG 的人连 mvn clean package 都跑不完。

        上传走 central-publishing-plugin（Sonatype 已下线旧的 Nexus staging 流程）。
        workingDirectory 默认在 target/central-publishing，上传后处于「待发布」状态，
        到 https://central.sonatype.com 手动点 Publish，或把 autoPublish 设为 true。
    -->
    <profiles>

        <profile>
            <id>central</id>

            <build>
                <plugins>

                    <!-- 附属构件：sources.jar / javadoc.jar，Central 的硬门槛 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!--
                                        必须加 pinentry-mode=loopback 这个参数。
                                        不加的话，GPG 2.1+ 会尝试弹出图形密码框，
                                        而 mvn 在非交互终端里跑就会一直挂着不返回。
                                        配合 ~/.m2/settings.xml 里 gpg.passphrase 使用。
                                    -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- 与 ~/.m2/settings.xml 里 <server><id>central</id> 对应 -->
                            <publishingServerId>central</publishingServerId>
                            <!--
                                先停在待发布状态，人工确认后再点 Publish。
                                发布到 Central 是不可撤销的：坐标一旦上传，
                                即使删掉也永远不能再用同一个版本号重发。
                            -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>

                </plugins>
            </build>

        </profile>

        <!--
            dev：单元测试模块，默认不参与构建，需要时显式启用：

                mvn -Pdev -pl dbupgrade-tests -am test

            测试与产物分离，日常构建与发布不受它影响。
        -->
        <profile>
            <id>dev</id>
            <modules>
                <module>dbupgrade-tests</module>
            </modules>
        </profile>

    </profiles>

</project>
