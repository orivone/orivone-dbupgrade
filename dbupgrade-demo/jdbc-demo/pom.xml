<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.orivone</groupId>
        <artifactId>dbupgrade-demo</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>jdbc-demo</artifactId>
    <version>1.0.1</version>

    <!--
        不使用 Spring 的原生接入示例。

        定位：只依赖 orivone-dbupgrade-core + JDBC 驱动，自己提供连接（DriverManager 或连接池），
        完全不经过 Spring Boot 的自动配置与包扫描。

        命名说明：模块名取自「原生（native）接入」，但 native 是 Java 语言关键字，
        不能作为包名的一段，故 Java 包名把 native 与 demo 合并为一个词：
        com.orivone.dbupgrade.demo.jdbcdemo。

        「能编译」本身就是一条验证：
        本模块的依赖里没有任何 Spring jar，如果哪天有人往 core 里偷偷塞了
        Spring 的 import，这里会立刻编译失败。
    -->
    <dependencies>

        <dependency>
            <groupId>com.orivone</groupId>
            <artifactId>orivone-dbupgrade-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!--
            ========================================================================
            JDBC 驱动（全部 runtime，仅 demo 使用）
            ========================================================================
            一个数据库一个 demo，各自需要自己的驱动：H2JdbcDemo 之外，
            Mysql / Postgresql / Oracle / Dm / SqlServer 五个 demo 分别对应下面的驱动。
            真实工程按需引入其中一个，不要把这一堆都带进生产依赖。

            版本在这里显式写死，是因为 Boot 2.7.18 的 BOM 管理的是
            postgresql 42.3.8 / mssql-jdbc 10.2.3.jre8 这类老版本，
            被它覆盖后驱动与新版数据库可能连不上。MySQL 驱动例外：
            由根 pom 的 mysql.version（8.0.33）统一管理，能横跨 5.7 / 8.0 / 8.4。
            ========================================================================
        -->

        <!-- MySQL 5.7+ / MariaDB -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL 及其衍生库（人大金仓 / openGauss / GaussDB / HighGo / Vastbase） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Oracle：ojdbc8 是 Java 8 基线版本，ojdbc11 需要 JDK 11+ -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>23.5.0.24.07</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 达梦 DM -->
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
            <version>8.1.3.62</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            SQL Server。13.x 驱动自带 Java 11 字节码，运行该 demo 需要 JDK 11+；
            JDK 8 环境下换成 10.2.3.jre8 即可（框架产物本身仍是 Java 8 字节码）。
        -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>13.4.0.jre11</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            默认跑 H2 内存库，让 demo 零配置即可运行（不需要先装任何数据库）。
            版本由 Spring Boot BOM 管理（2.1.214，Java 8 字节码）。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            core 的 slf4j-api 是 provided、不传递，所以脱离 Spring 使用时
            必须自己补「门面 + 绑定」两件东西。这里用最简单的 slf4j-simple。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

</project>
